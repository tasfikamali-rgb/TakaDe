// Shared build settings for the TakaDe app target.

// The iOS OAuth client id from the owner's Google Cloud project, e.g.
// 1234-abcd.apps.googleusercontent.com. Leave empty to hide "Continue with Google".
// Set it in Config/Google.local.xcconfig (not committed); see Google.local.xcconfig.example.
TAKADE_GOOGLE_CLIENT_ID =

#include? "Google.local.xcconfig"

// TakaDe accounts (docs/adr/0016-accounts-on-supabase.md). The Supabase project host,
// e.g. abcdefghijkl.supabase.co (no https://, since // starts a comment here), and its
// public anon key. Set them in Config/Supabase.local.xcconfig (not committed); see
// Supabase.local.xcconfig.example. Left empty, sign-in stays on this phone only (Apple,
// Google) and email and Microsoft are hidden. Never put the service-role key here.
TAKADE_SUPABASE_HOST = yxsfbakrtmpsuuuuogbl.supabase.co
TAKADE_SUPABASE_ANON_KEY =

// Sign-in methods that need more Supabase setup before they work. Turn each on (YES)
// only once its setup is done; see supabase/README.md.
// Microsoft: the Azure provider (needs an Azure app registration).
// Email codes: a custom email sender (SMTP) and the 6-digit code email template.
TAKADE_MICROSOFT_SIGN_IN = NO
TAKADE_EMAIL_SIGN_IN = NO

#include? "Supabase.local.xcconfig"

// Signing for installs on your own phone. Put these in Config/Signing.local.xcconfig
// (not committed) so they survive `xcodegen generate`:
//   DEVELOPMENT_TEAM = ABCDE12345
//   TAKADE_BUNDLE_SUFFIX = .yourname   (only if a free team can't use app.takade.ios)
TAKADE_BUNDLE_SUFFIX =
PRODUCT_BUNDLE_IDENTIFIER = app.takade.ios$(TAKADE_BUNDLE_SUFFIX)
CODE_SIGN_STYLE = Automatic

#include? "Signing.local.xcconfig"
