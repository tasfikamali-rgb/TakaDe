{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "comment": "App name under the icon; kept in Latin. Bengali drafted by Claude; needs native review before release.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "TakaDe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TakaDe"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Camera permission prompt. Bengali drafted by Claude; needs native review before release.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "রসিদ এবং বন্ধুর TakaDe আইডির QR কোড স্ক্যান করতে TakaDe ক্যামেরা ব্যবহার করে। রসিদের ছবি খরচের সাথে থাকে; শেয়ার করা গ্রুপে পাঠানোর আগে এটি এনক্রিপ্ট করা হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TakaDe uses the camera to scan receipts and friends' TakaDe ID QR codes. A receipt photo stays with its expense; in a shared group it's encrypted before it's sent."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "comment": "Contacts permission prompt. Bengali drafted by Claude; needs native review before release.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "গ্রুপে মানুষ যোগ করতে খুঁজে বাছাই করার জন্য TakaDe আপনার কন্ট্যাক্ট দেখায়। শুধু আপনার বাছাই করা নামগুলো এই ফোনে রাখা হয়। কন্ট্যাক্ট কখনো আপলোড হয় না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TakaDe shows your contacts so you can search and pick people to add to a group. Only the names you pick are kept, on this phone. Your contacts are never uploaded."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "comment": "Face ID permission prompt. Bengali drafted by Claude; needs native review before release.",
      "extractionState": "manual",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "সেটিংসে লক চালু করলে অ্যাপ খুলতে TakaDe Face ID ব্যবহার করে। আপনার মুখের তথ্য iOS-এর কাছেই থাকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TakaDe uses Face ID to unlock the app when you turn on the lock in Settings. Your face data stays with iOS."
          }
        }
      }
    }
  },
  "version": "1.0"
}
