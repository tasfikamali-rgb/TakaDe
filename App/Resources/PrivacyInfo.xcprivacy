<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest for the TakaDe app target.
  Keep this in sync with what the app actually does; scripts/ci/store_check.py
  fails CI when the source uses a "required reason" API that is not declared here.

  Current behaviour (local-only MVP): no tracking, no data collected by the
  developer, nothing leaves the device. Receipt text is read on the device.
  Sign in with Apple / Google (ADR 0011) runs on the device: the provider user id,
  name and optional email are stored in the local profile and refresh tokens in the
  Keychain. TakaDe has no server, so the developer never receives them; that is not
  "collection" in Apple's sense, and NSPrivacyCollectedDataTypes stays empty.
  If a sync service, analytics or crash reporting is added, update
  NSPrivacyCollectedDataTypes and the App Store privacy label together.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: read/write info only accessible to the app itself (language, digit style, your name). -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
