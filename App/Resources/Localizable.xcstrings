          "stringUnit": {
            "state": "needs_review",
            "value": "ফাইলে আপনার সব গ্রুপ, নাম ও টাকার হিসাব আছে। শেয়ার করলে তা আর TakaDe-এর সুরক্ষায় থাকে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file holds all your groups, names and amounts. Once you share it, it's outside TakaDe's protection."
          }
        }
      }
    },
