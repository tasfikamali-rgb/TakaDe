    },
    "We didn't find an account for that sign-in, so we made a new one. What should we call you?": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই সাইন-ইনে কোনো অ্যাকাউন্ট পাওয়া যায়নি, তাই নতুন একটি খোলা হয়েছে। আপনাকে কী নামে ডাকব?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We didn't find an account for that sign-in, so we made a new one. What should we call you?"
          }
        }
      }
    },
    "You already had a TakaDe account, so we signed you in.": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার আগে থেকেই TakaDe অ্যাকাউন্ট ছিল, তাই সাইন ইন করিয়ে দেওয়া হয়েছে।"
          }
        },
        "en": {
