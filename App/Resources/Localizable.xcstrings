    "Sign in to use TakaDe on a new phone later. New here or coming back, it's the same button. Your groups and expenses stay on this phone either way.": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "পরে নতুন ফোনে TakaDe ব্যবহার করতে সাইন ইন করুন। নতুন হোন বা ফিরে আসুন, বোতাম একই। আপনার গ্রুপ আর খরচ সবসময় এই ফোনেই থাকে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to use TakaDe on a new phone later. New here or coming back, it's the same button. Your groups and expenses stay on this phone either way."
          }
        }
      }
    },
    "Signing in keeps your email with your groups. It all stays on this phone.": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
