    },
    "If %@ has a TakaDe account, we've sent it a 6-digit code. If nothing arrives, go back and choose Create an account.": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-এ TakaDe অ্যাকাউন্ট থাকলে সেখানে ৬ সংখ্যার কোড পাঠানো হয়েছে। কিছু না এলে পেছনে গিয়ে অ্যাকাউন্ট খুলুন বেছে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If %@ has a TakaDe account, we've sent it a 6-digit code. If nothing arrives, go back and choose Create an account."
          }
        }
      }
    },
    "We've sent a 6-digit code to %@.": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-এ ৬ সংখ্যার কোড পাঠানো হয়েছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We've sent a 6-digit code to %@."
          }
        }
      }
    },
    "Your TakaDe account and its sign-in methods are deleted from TakaDe's sign-in service, and you're signed out on this phone. This can't be undone.": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার TakaDe অ্যাকাউন্ট ও তার সাইন-ইন উপায়গুলো TakaDe-র সাইন-ইন সার্ভিস থেকে মুছে যাবে, আর এই ফোনে আপনি সাইন আউট হবেন। এটি ফেরানো যাবে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your TakaDe account and its sign-in methods are deleted from TakaDe's sign-in service, and you're signed out on this phone. This can't be undone."
          }
        }
      }
    },
    "Remove this sign-in method?": {
