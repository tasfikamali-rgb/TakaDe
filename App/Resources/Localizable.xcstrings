        }
      }
    },
    "This is how you appear in new groups, exactly as you type it": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "নতুন গ্রুপে আপনাকে ঠিক এভাবেই দেখাবে, যেমন লিখেছেন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is how you appear in new groups, exactly as you type it"
          }
        }
      }
    },
    "Your TakaDe account and its sign-in methods are deleted from TakaDe's sign-in service, and you're signed out on this phone. This can't be undone.": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার TakaDe অ্যাকাউন্ট ও তার সাইন-ইন উপায়গুলো TakaDe-র সাইন-ইন সার্ভিস থেকে মুছে যাবে, আর এই ফোনে আপনি সাইন আউট হবেন। এটি ফেরানো যাবে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your TakaDe account and its sign-in methods are deleted from TakaDe's sign-in service, and you're signed out on this phone. This can't be undone."
          }
        }
      }
    },
    "Remove this sign-in method?": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই সাইন-ইন উপায়টি সরাবেন?"
