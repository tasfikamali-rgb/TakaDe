        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add another way to sign in to the same account."
          }
        }
      }
    },
    "We didn't find an account for that sign-in, so we made a new one for you.": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই সাইন-ইনে কোনো অ্যাকাউন্ট পাওয়া যায়নি, তাই আপনার জন্য নতুন একটি খোলা হয়েছে।"
          }
