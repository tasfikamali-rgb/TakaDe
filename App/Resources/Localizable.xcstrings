            "value": "Remove"
          }
        }
      }
    },
    "You won't be able to sign in with %@ any more. Your other sign-in methods still work.": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ দিয়ে আর সাইন ইন করতে পারবেন না। আপনার অন্য সাইন-ইন উপায়গুলো কাজ করবে।"
          }
        },
        "en": {
