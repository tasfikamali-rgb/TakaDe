    "Sign in with Apple didn't work on this phone. Try another way, or continue without an account.": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই ফোনে Apple দিয়ে সাইন ইন কাজ করেনি। অন্যভাবে চেষ্টা করুন, অথবা অ্যাকাউন্ট ছাড়াই চালিয়ে যান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple didn't work on this phone. Try another way, or continue without an account."
