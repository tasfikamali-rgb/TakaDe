    },
    "Your groups, expenses and payments stay on this phone, in an encrypted file that unlocks after you first unlock your phone. They're never uploaded.": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার গ্রুপ, খরচ ও পেমেন্ট এই ফোনেই থাকে, একটি এনক্রিপ্ট করা ফাইলে, যা ফোন প্রথমবার আনলক করার পর খোলে। এগুলো কখনো আপলোড হয় না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your groups, expenses and payments stay on this phone, in an encrypted file that unlocks after you first unlock your phone. They're never uploaded."
          }
        }
      }
    },
    "Temporary email addresses can't be used with TakaDe. Use an email you'll keep, so you can always sign back in.": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "অস্থায়ী ইমেইল ঠিকানা দিয়ে TakaDe ব্যবহার করা যায় না। এমন একটি ইমেইল দিন যা আপনি রাখবেন, যাতে সবসময় আবার সাইন ইন করতে পারেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary email addresses can't be used with TakaDe. Use an email you'll keep, so you can always sign back in."
          }
        }
      }
    },
