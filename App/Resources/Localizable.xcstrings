    "In a shared group, everyone in it can see this photo. It's encrypted on the phone before it's sent.": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "শেয়ার করা গ্রুপে সবাই এই ছবি দেখতে পারবেন। পাঠানোর আগে ছবিটি ফোনেই এনক্রিপ্ট করা হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a shared group, everyone in it can see this photo. It's encrypted on the phone before it's sent."
          }
        }
      }
    },
    "Only invite links from TakaDe work here. Ask someone in the group to tap the invite button in the group and send you the link.": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এখানে শুধু TakaDe-এর ইনভাইট লিংক কাজ করে। গ্রুপের কাউকে গ্রুপের ইনভাইট বোতামে চাপ দিয়ে আপনাকে লিংকটি পাঠাতে বলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only invite links from TakaDe work here. Ask someone in the group to tap the invite button in the group and send you the link."
          }
        }
      }
    },
    "This invite link is incomplete. Copy the whole message again and paste it here.": {
      "comment": "Bengali drafted by Claude; needs native review before release.",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "needs_review",
